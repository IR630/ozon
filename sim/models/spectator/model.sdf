<?xml version="1.0"?>
<!-- Spectator camera for run videos (day 3, P5; hero framing week 5). NOT part
     of cell.sdf on purpose: a rendering sensor costs RTF under llvmpipe, so it
     is spawned into the running world only by scripts/record_skeleton_video.sh.
     Elevated three-quarter from the upstream-D corner looking DOWN the line:
     the belt leads the eye from the infeed (near) through the camera station,
     both diverters and all three zones B/C/D (far). Pose chosen against the
     cell.sdf geometry and previewed with scripts/frame_spectator.sh (week 5,
     candidate b3) — the earlier D-side pose framed half the frame as empty
     floor with the action off to one side. This overview pose frames all three
     zones for ANY item.

     CLOSE-UP, added 29.07: "1.5 -1.7 1.35 0 0.42 0.95". Use it for small items —
     from the overview a 9 mm pen is a few pixels and the clip proves the rule only
     in its caption. Frame width is ~1.15 x distance at this 1.3 rad FOV, so the
     130 mm pen goes from ~32 px at the overview's 2.9 m to ~47 px at 1.95 m; both
     blades and the C chute stay in shot, the gantry post sits at the left edge.

     The pose previously recommended here for close-ups, "0.8 -2.6 2.2 0 0.544
     0.880", was framed against the bare cell.sdf and is NOT usable on the diverter
     rig: the gantry post stands across the middle of the frame. Preview a pose in
     the world you will actually film — `WORLD=... scripts/frame_spectator.sh` now
     takes the world and spawns the gantry prop for exactly this reason. Note the
     preview still lacks the belt pre-roll the episode does, so framing shifts a
     little between preview and footage. -->

<!-- Overview pose kept as the committed default: it is the one that suits any item. -->
<sdf version="1.8">
  <model name="spectator">
    <static>true</static>
    <pose>-1.0 -3.0 3.0 0 0.545 0.753</pose>
    <link name="link">
      <sensor name="cam" type="camera">
        <update_rate>10</update_rate>
        <topic>spectator/image</topic>
        <camera>
          <horizontal_fov>1.3</horizontal_fov>
          <image><width>800</width><height>450</height></image>
          <clip><near>0.1</near><far>20.0</far></clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
