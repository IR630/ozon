<?xml version="1.0"?>
<!-- Spectator camera for run videos (day 3, P5). NOT part of cell.sdf on
     purpose: a rendering sensor costs RTF under llvmpipe, so it is spawned
     into the running world only by scripts/record_skeleton_video.sh.
     Three-quarter view from the D side covering the guide-rail exit, the
     camera window, both pushers and all three zones. -->
<sdf version="1.8">
  <model name="spectator">
    <static>true</static>
    <pose>1.2 -3.6 2.9 0 0.66 1.5708</pose>
    <link name="link">
      <sensor name="cam" type="camera">
        <update_rate>10</update_rate>
        <topic>spectator/image</topic>
        <camera>
          <horizontal_fov>1.3</horizontal_fov>
          <image><width>800</width><height>450</height></image>
          <clip><near>0.1</near><far>20.0</far></clip>
        </camera>
      </sensor>
    </link>
  </model>
</sdf>
