<?xml version="1.0"?>
<sdf version="1.8">
  <!-- Text-only CI fixture: same 400x400x300 mm envelope and 3 kg mass as the
       generated large box, but no organizer-provided binary STL in git. -->
  <model name="item_box_400x400x300">
    <link name="link">
      <inertial>
        <pose>0 0 0.15 0 0 0</pose>
        <mass>3.0</mass>
        <inertia>
          <ixx>0.0625</ixx><iyy>0.0625</iyy><izz>0.0800</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry><box><size>0.4 0.4 0.3</size></box></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0.15 0 0 0</pose>
        <geometry><box><size>0.4 0.4 0.3</size></box></geometry>
        <material><ambient>0.55 0.35 0.15 1</ambient><diffuse>0.55 0.35 0.15 1</diffuse></material>
      </visual>
    </link>
  </model>
</sdf>
