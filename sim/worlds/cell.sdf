<?xml version="1.0"?>
<!--
  Sorting cell world, 6 x 10 m (docs/md/plan.md): infeed conveyor A along +X,
  zone B = sorter infeed past the belt end, roll-cages C/D on the belt sides.

  Belt speed is NOT hardcoded here: it is commanded at runtime on
  /conveyor/cmd_vel by scripts/orchestration, which read BELT_SPEED_M_S from
  src/constants.py (single source of domain constants). Command it with a
  soft-start ramp, never a 0->1 m/s step: the jerk launches round items
  (docs/decisions.md 2026-07-11, scripts/check_stability.sh).
-->
<sdf version="1.8">
  <world name="cell">
    <physics name="default" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <pose>0 0 8 0 0.3 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <cast_shadows>true</cast_shadows>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- work area floor 10 x 6 m -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 6</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 6</size></plane></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- infeed conveyor A: belt top at z = 0.4, working section x = 0..3.
         Implementation: a long platform on a prismatic joint driven at
         constant velocity (JointController). Real friction carries items —
         TrackController turned out to be inert on a world-welded link
         (docs/decisions.md). The 9 m platform gives ~3 m of travel per
         episode; runs are short and reset the world anyway (seed principle). -->
    <model name="conveyor">
      <pose>1.5 0 0.35 0 0 0</pose>
      <link name="belt">
        <inertial><mass>200</mass><inertia><ixx>20</ixx><iyy>20</iyy><izz>20</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>9.0 0.5 0.1</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>9.0 0.5 0.1</size></box></geometry>
          <material><ambient>0.2 0.2 0.25 1</ambient><diffuse>0.2 0.2 0.25 1</diffuse></material>
        </visual>
      </link>
      <joint name="belt_joint" type="prismatic">
        <parent>world</parent>
        <child>belt</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit><lower>-3.2</lower><upper>3.2</upper></limit>
        </axis>
      </joint>
      <!-- belt speed (m/s) is commanded at runtime on this topic; the value
           comes from BELT_SPEED_M_S in src/constants.py -->
      <plugin filename="ignition-gazebo-joint-controller-system" name="ignition::gazebo::systems::JointController">
        <joint_name>belt_joint</joint_name>
        <topic>/conveyor/cmd_vel</topic>
      </plugin>
    </model>

    <!-- static infeed side guides (day 3): tall rails over the belt edges on
         the spawn/ramp section. The helmet hull is a rocking chair — the
         start ramp excites rocking and it deterministically rolls off in +y,
         unfixable by tuning (docs/decisions.md 2026-07-11). The rails damp
         the rocking by contact while the ramp runs; items reach the camera
         already settled at constant speed (no lateral excitation remains).
         Geometry constraints, all load-bearing:
         - a LOW in-window curb does NOT work: rolling forward at 1 m/s the
           helmet climbs a 15 mm lip at grazing angle like a wheel on a rail
           (verified in-sim) — hence tall rails, but strictly OUTSIDE the
           camera window: they end at x=0.7, the window starts at x=0.88
           (even at rail-top height) — perception sees pure belt;
         - items must spawn inside the rails (run_skeleton.sh: x=-1.5; the
           controller's sim-time ramp covers ~1.35 m and completes by x=-0.15
           with ~0.8 m of settle distance left). The rails run long upstream
           so that even the slower CLI-paced ramp of check_stability.sh
           (each `ign topic` call adds ~0.5 s → ~3 m of ramp travel from its
           deeper x=-5 spawn) completes fully guided;
         - 2 mm clear of the moving belt platform in y — no rubbing contact;
         - pusher ejection paths (x=2.5 / 3.0) untouched -->
    <model name="belt_guides">
      <static>true</static>
      <link name="link">
        <collision name="left">
          <pose>-2.65 0.272 0.39 0 0 0</pose>
          <geometry><box><size>6.7 0.04 0.18</size></box></geometry>
        </collision>
        <visual name="left_visual">
          <pose>-2.65 0.272 0.39 0 0 0</pose>
          <geometry><box><size>6.7 0.04 0.18</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
        <collision name="right">
          <pose>-2.65 -0.272 0.39 0 0 0</pose>
          <geometry><box><size>6.7 0.04 0.18</size></box></geometry>
        </collision>
        <visual name="right_visual">
          <pose>-2.65 -0.272 0.39 0 0 0</pose>
          <geometry><box><size>6.7 0.04 0.18</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- RGBD camera above the belt, looking straight down -->
    <model name="camera">
      <static>true</static>
      <pose>1.5 0 1.9 0 1.5708 0</pose>
      <link name="link">
        <sensor name="rgbd" type="rgbd_camera">
          <update_rate>15</update_rate>
          <topic>camera</topic>
          <camera>
            <horizontal_fov>1.05</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.1</near><far>5.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- pushers v0 (day 2 P2 + day 3): paddles on prismatic joints, home just
         off the belt edges. pusher_c (x=2.5, -Y home) shoves items in +Y
         toward zone C; pusher_d (x=3.0, +Y home) shoves toward zone D. They
         are STAGGERED in x on purpose: face-to-face at the same x, each parked
         paddle walls off the other's ejection path (verified: the box punched
         through pusher_d's parked paddle, the plate jammed against pusher_c's).
         Single-shot placeholders — the real mechanism is chosen on day 5 from
         experiment data. Same prismatic + JointController pattern as the
         conveyor (docs/decisions.md). -->
    <model name="pusher_c">
      <pose>2.5 -0.3 0.5 0 0 0</pose>
      <link name="paddle">
        <inertial><mass>5</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.30 0.03 0.30</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.30 0.03 0.30</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <joint name="pusher_joint" type="prismatic">
        <parent>world</parent>
        <child>paddle</child>
        <axis>
          <xyz>0 1 0</xyz>
          <limit><lower>0</lower><upper>1.5</upper></limit>
        </axis>
      </joint>
      <plugin filename="ignition-gazebo-joint-controller-system" name="ignition::gazebo::systems::JointController">
        <joint_name>pusher_joint</joint_name>
        <topic>/pusher_c/cmd</topic>
      </plugin>
    </model>
    <model name="pusher_d">
      <pose>3.0 0.3 0.5 0 0 0</pose>
      <link name="paddle">
        <inertial><mass>5</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>0.30 0.03 0.30</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.30 0.03 0.30</size></box></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
      <!-- axis -Y so a POSITIVE command extends toward zone D: the controller
           speaks one convention (+v = fire) for both pushers -->
      <joint name="pusher_joint" type="prismatic">
        <parent>world</parent>
        <child>paddle</child>
        <axis>
          <xyz>0 -1 0</xyz>
          <limit><lower>0</lower><upper>1.5</upper></limit>
        </axis>
      </joint>
      <plugin filename="ignition-gazebo-joint-controller-system" name="ignition::gazebo::systems::JointController">
        <joint_name>pusher_joint</joint_name>
        <topic>/pusher_d/cmd</topic>
      </plugin>
    </model>

    <!-- zone B: sorter infeed marker past the belt end -->
    <model name="zone_b">
      <static>true</static>
      <pose>3.8 0 0.005 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 0.8 0.01</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.8 0.01</size></box></geometry>
          <material><ambient>0.2 0.7 0.2 1</ambient><diffuse>0.2 0.7 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- zones C/D: landing patches + roll-cage 1200x800x800 visuals.
         Placed right off the belt edge (|y| = 0.9) and x-aligned with their
         pushers: the paddle loses contact when the item drops off the belt,
         so the item must LAND in the zone, not travel to it -->
    <model name="zone_c">
      <static>true</static>
      <pose>2.5 0.9 0.005 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.8 0.01</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.8 0.01</size></box></geometry>
          <material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material>
        </visual>
        <!-- far cage wall IS physical: fast/heavy items (Короб 400, 3 kg)
             overfly the patch and must be caught, like in a real roll-cage -->
        <collision name="cage_wall">
          <pose>0 0.6 0.4 0 0 0</pose>
          <geometry><box><size>1.2 0.05 0.8</size></box></geometry>
        </collision>
        <visual name="cage">
          <pose>0 0.6 0.4 0 0 0</pose>
          <geometry><box><size>1.2 0.05 0.8</size></box></geometry>
          <material><ambient>0.4 0.4 0.9 0.6</ambient><diffuse>0.4 0.4 0.9 0.6</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="zone_d">
      <static>true</static>
      <pose>3.0 -0.9 0.005 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.8 0.01</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.8 0.01</size></box></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
        </visual>
        <collision name="cage_wall">
          <pose>0 -0.6 0.4 0 0 0</pose>
          <geometry><box><size>1.2 0.05 0.8</size></box></geometry>
        </collision>
        <visual name="cage">
          <pose>0 -0.6 0.4 0 0 0</pose>
          <geometry><box><size>1.2 0.05 0.8</size></box></geometry>
          <material><ambient>0.9 0.6 0.3 0.6</ambient><diffuse>0.9 0.6 0.3 0.6</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
