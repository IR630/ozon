<?xml version="1.0"?>
<!--
  Sorting cell world, DIVERTER (shiber) variant — day 5 mechanism experiment.

  Identical to cell.sdf EXCEPT the two ballistic pushers are replaced by two
  swing-arm diverters (steerable deflector blades on revolute joints). Where the
  pusher ejects the item off the belt at 2.5 m/s (an impact — "brak" on the
  10-point manipulation-quality criterion), the diverter parks a blade along the
  belt edge and swings it ~45 deg across the belt so the MOVING belt guides the
  item sideways at belt speed (~1 m/s), no impulsive shove. Same JointController
  command topics (/pusher_c/cmd, /pusher_d/cmd) and the same +v/-v/0 vocabulary
  as the pushers, so src/controller_node.py and src/tracking.py are UNCHANGED;
  the mechanism is selected at runtime by run_skeleton.sh's WORLD seam.

  Belt speed is commanded on /conveyor/cmd_vel from BELT_SPEED_M_S with a
  soft-start ramp (docs/decisions.md 2026-07-11), same as cell.sdf.
-->
<sdf version="1.8">
  <world name="cell">
    <physics name="default" type="ode">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <pose>0 0 8 0 0.3 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <cast_shadows>true</cast_shadows>
      <direction>-0.3 0.2 -0.9</direction>
    </light>

    <!-- work area floor 10 x 6 m -->
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>10 6</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 6</size></plane></geometry>
          <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Operational safety marking (visual-only, no collision/physics effect).
         Red perimeter encloses the moving belt, camera and routing/landing area;
         green strip is the operator-side safe walkway outside that perimeter. -->
    <model name="safety_marking">
      <static>true</static>
      <link name="link">
        <visual name="hazard_north">
          <pose>1.5 1.55 0.012 0 0 0</pose>
          <geometry><box><size>6.0 0.08 0.02</size></box></geometry>
          <material><ambient>0.9 0.05 0.05 1</ambient><diffuse>0.9 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="hazard_south">
          <pose>1.5 -1.55 0.012 0 0 0</pose>
          <geometry><box><size>6.0 0.08 0.02</size></box></geometry>
          <material><ambient>0.9 0.05 0.05 1</ambient><diffuse>0.9 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="hazard_infeed">
          <pose>-1.5 0 0.012 0 0 0</pose>
          <geometry><box><size>0.08 3.1 0.02</size></box></geometry>
          <material><ambient>0.9 0.05 0.05 1</ambient><diffuse>0.9 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="hazard_outfeed">
          <pose>4.5 0 0.012 0 0 0</pose>
          <geometry><box><size>0.08 3.1 0.02</size></box></geometry>
          <material><ambient>0.9 0.05 0.05 1</ambient><diffuse>0.9 0.05 0.05 1</diffuse></material>
        </visual>
        <visual name="operator_safe_walkway">
          <pose>1.5 2.3 0.006 0 0 0</pose>
          <geometry><box><size>6.0 0.7 0.01</size></box></geometry>
          <material><ambient>0.1 0.65 0.15 0.45</ambient><diffuse>0.1 0.65 0.15 0.45</diffuse></material>
          <transparency>0.55</transparency>
        </visual>
      </link>
    </model>

    <!-- infeed conveyor A: belt top at z = 0.4, working section x = 0..3.
         Prismatic platform driven at constant velocity by JointController on
         /conveyor/cmd_vel (see cell.sdf for rationale). -->
    <model name="conveyor">
      <pose>1.5 0 0.35 0 0 0</pose>
      <link name="belt">
        <inertial><mass>200</mass><inertia><ixx>20</ixx><iyy>20</iyy><izz>20</izz></inertia></inertial>
        <collision name="collision">
          <geometry><box><size>9.0 0.5 0.1</size></box></geometry>
          <!-- Diverter belt: high drive friction ALONG the belt (fdir1 = +X, mu),
               low friction ACROSS it (mu2). The belt still carries items forward,
               but the angled blade can slide them sideways off the edge — with the
               isotropic mu2=1.0 of cell.sdf the belt pins items laterally and a
               gentle guide cannot divert them. -->
          <surface><friction><ode><mu>1.0</mu><mu2>0.2</mu2><fdir1>1 0 0</fdir1></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>9.0 0.5 0.1</size></box></geometry>
          <material><ambient>0.2 0.2 0.25 1</ambient><diffuse>0.2 0.2 0.25 1</diffuse></material>
        </visual>
      </link>
      <joint name="belt_joint" type="prismatic">
        <parent>world</parent>
        <child>belt</child>
        <axis>
          <xyz>1 0 0</xyz>
          <limit><lower>-3.2</lower><upper>3.2</upper></limit>
        </axis>
      </joint>
      <plugin filename="ignition-gazebo-joint-controller-system" name="ignition::gazebo::systems::JointController">
        <joint_name>belt_joint</joint_name>
        <topic>/conveyor/cmd_vel</topic>
      </plugin>
    </model>

    <!-- static infeed side guides (day 3): tall rails over the belt edges on
         the spawn/ramp section, damping helmet rocking before the camera window.
         Identical to cell.sdf; end at x=0.7, well upstream of the diverters. -->
    <model name="belt_guides">
      <static>true</static>
      <link name="link">
        <collision name="left">
          <pose>-2.65 0.272 0.39 0 0 0</pose>
          <geometry><box><size>6.7 0.04 0.18</size></box></geometry>
        </collision>
        <visual name="left_visual">
          <pose>-2.65 0.272 0.39 0 0 0</pose>
          <geometry><box><size>6.7 0.04 0.18</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
        <collision name="right">
          <pose>-2.65 -0.272 0.39 0 0 0</pose>
          <geometry><box><size>6.7 0.04 0.18</size></box></geometry>
        </collision>
        <visual name="right_visual">
          <pose>-2.65 -0.272 0.39 0 0 0</pose>
          <geometry><box><size>6.7 0.04 0.18</size></box></geometry>
          <material><ambient>0.5 0.5 0.55 1</ambient><diffuse>0.5 0.5 0.55 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- RGBD camera above the belt, looking straight down -->
    <model name="camera">
      <static>true</static>
      <pose>1.5 0 1.9 0 1.5708 0</pose>
      <link name="link">
        <sensor name="rgbd" type="rgbd_camera">
          <update_rate>15</update_rate>
          <topic>camera</topic>
          <camera>
            <horizontal_fov>1.05</horizontal_fov>
            <image><width>640</width><height>480</height></image>
            <clip><near>0.1</near><far>5.0</far></clip>
          </camera>
        </sensor>
      </link>
    </model>

    <!-- DIVERTERS (day 5): steerable deflector blades on revolute joints, the
         gentle alternative to the ballistic pushers. Each blade parks along its
         belt edge (joint angle 0, out of the item path) and, on a +v command,
         swings ~45 deg (0.79 rad) across the belt; the moving belt then guides
         the item off the near edge onto the zone patch at belt speed. Staggered
         in x so the parked blades never wall off each other's path, exactly like
         the pushers.
         PIVOT X IS CAMERA-CONSTRAINED, not PUSHER_X_M-aligned: the top-down
         camera (x=1.5, z=1.9, hfov 1.05) sees world x up to
         1.5 + tan(0.525)*(1.9 - z); at the blade's bottom (z=0.35) that is
         x=2.40. A parked blade inside the frame stands above the belt plane,
         its mask blob touches the frame border and perception returns None on
         EVERY frame (the day-5 full-loop blocker: box_400 rode to B with zero
         "item N:" lines). So the parked blade (pivot - 0.8 m) must start at
         x >= 2.4 -> pivot C at 3.25, D staggered +0.5 at 3.75. Fire timing:
         the controller fires FIRE_LEAD_S=0.5 s before the item reaches
         PUSHER_X_M (fire_lead_s parameter) so the sweeping blade tip never
         meets the item mid-swing; the wall is fully formed ~0.4 s later with
         the item's front edge still upstream of the sweep zone.
         diverter_c: pivot at the +Y edge, axis +Z -> +v deflects toward zone C.
         diverter_d: pivot at the -Y edge, axis -Z -> +v deflects toward zone D
         (mirror of the pusher_d axis trick: one convention, +v = engage). -->
    <model name="diverter_c">
      <pose>3.25 0.28 0.5 0 0 0</pose>
      <link name="blade">
        <inertial><mass>5</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <collision name="collision">
          <pose>-0.40 0 0 0 0 0</pose>
          <geometry><box><size>0.80 0.03 0.30</size></box></geometry>
          <!-- low-friction guide face: the item should SLIDE along the blade off
               the belt edge, not grip it — this is what keeps the diverter gentle.
               Length 0.8 m: at the 45 deg engage angle the blade spans the full
               0.5 m belt width and reaches past the far edge, so a centered item
               always meets the flat FACE (not the tip) and is funnelled to the
               anchored (near) edge — a short blade let the item jam on its tip. -->
          <surface><friction><ode><mu>0.2</mu><mu2>0.2</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <pose>-0.40 0 0 0 0 0</pose>
          <geometry><box><size>0.80 0.03 0.30</size></box></geometry>
          <material><ambient>0.8 0.2 0.2 1</ambient><diffuse>0.8 0.2 0.2 1</diffuse></material>
        </visual>
      </link>
      <joint name="diverter_joint" type="revolute">
        <parent>world</parent>
        <child>blade</child>
        <axis>
          <xyz>0 0 1</xyz>
          <limit><lower>0</lower><upper>0.95</upper></limit>
        </axis>
      </joint>
      <plugin filename="ignition-gazebo-joint-controller-system" name="ignition::gazebo::systems::JointController">
        <joint_name>diverter_joint</joint_name>
        <topic>/pusher_c/cmd</topic>
      </plugin>
    </model>
    <model name="diverter_d">
      <pose>3.75 -0.28 0.5 0 0 0</pose>
      <link name="blade">
        <inertial><mass>5</mass><inertia><ixx>0.1</ixx><iyy>0.1</iyy><izz>0.1</izz></inertia></inertial>
        <collision name="collision">
          <pose>-0.40 0 0 0 0 0</pose>
          <geometry><box><size>0.80 0.03 0.30</size></box></geometry>
          <!-- low-friction guide face: the item should SLIDE along the blade off
               the belt edge, not grip it — this is what keeps the diverter gentle.
               Length 0.8 m: at the 45 deg engage angle the blade spans the full
               0.5 m belt width and reaches past the far edge, so a centered item
               always meets the flat FACE (not the tip) and is funnelled to the
               anchored (near) edge — a short blade let the item jam on its tip. -->
          <surface><friction><ode><mu>0.2</mu><mu2>0.2</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <pose>-0.40 0 0 0 0 0</pose>
          <geometry><box><size>0.80 0.03 0.30</size></box></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
        </visual>
      </link>
      <!-- axis -Z so a POSITIVE command swings the blade across toward zone D:
           the controller speaks one convention (+v = engage) for both sides -->
      <joint name="diverter_joint" type="revolute">
        <parent>world</parent>
        <child>blade</child>
        <axis>
          <xyz>0 0 -1</xyz>
          <limit><lower>0</lower><upper>0.95</upper></limit>
        </axis>
      </joint>
      <plugin filename="ignition-gazebo-joint-controller-system" name="ignition::gazebo::systems::JointController">
        <joint_name>diverter_joint</joint_name>
        <topic>/pusher_d/cmd</topic>
      </plugin>
    </model>

    <!-- zone B: sorter infeed marker past the belt end -->
    <model name="zone_b">
      <static>true</static>
      <pose>3.8 0 0.005 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0 0.8 0.01</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0 0.8 0.01</size></box></geometry>
          <material><ambient>0.2 0.7 0.2 1</ambient><diffuse>0.2 0.7 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- zones C/D: landing patches + roll-cage 1200x800x800 visuals. Same
         patch geometry as cell.sdf but x-aligned with the diverter pivots
         (C=3.25, D=3.75): the blade funnels the item to its anchored (pivot)
         edge, so it leaves the belt near the pivot x at belt speed (not
         launched) and lands on the near part of the patch — the physical cage
         wall still backstops it. -->
    <!-- CHUTES (day 6): the ramp from the belt edge down to the zone patch.
         Without them the diverter's own two census failures are both the same:
         it guides the item off the belt gently (no ballistic shove), the item
         drops the full 0.4 m onto bare floor and STOPS 2-6 cm short of the
         patch (bottle oi1/oi2 at y=-0.48/-0.44 against the -0.5 patch edge;
         pen oi0 at y=0.464). The pusher only reached the patch by throwing the
         item at 2.5 m/s — which is exactly the impact we rejected.
         The same 0.4 m drop is also the gentleness ceiling: the peak of the
         diverter's trace is the LANDING (109 m/s^2), not the wall contact
         (68-77) — so the chute buys routing and manipulation quality at once.
         Geometry: top edge at y=+-0.25 (the belt edge) but z=0.34 — deliberately
         BELOW the blade's bottom edge (z=0.35, blade box 0.80x0.03x0.30 pivoted
         at z=0.5). The first cut ran the chute up to belt height (z=0.4) and it
         WEDGED the blade: parked at y=+-0.28 the blade sits inside the chute's
         y-span, so at z=0.4 the plate cut straight through it and the diverter
         could not swing at all (bottle rode the belt to the end, FAIL). The item
         now steps 6 cm off the belt edge onto the chute instead of dropping 40.
         Bottom edge on the patch (y=+-0.75, z=0) -> a 0.6 m slide at 34 deg
         (roll -+0.597 rad). Low friction so the item slides, not sticks.
         Starts at x=2.5 — BEHIND the camera window (its far edge is x~2.4 at
         belt height): a chute inside the frame would be segmented as the item
         and blind perception, the day-5 blocker that the blades already hit. -->
    <model name="chute_c">
      <static>true</static>
      <pose>3.2 0.5 0.17 -0.597 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.4 0.605 0.02</size></box></geometry>
          <surface><friction><ode><mu>0.2</mu><mu2>0.2</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.4 0.605 0.02</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="chute_d">
      <static>true</static>
      <pose>3.7 -0.5 0.17 0.597 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.4 0.605 0.02</size></box></geometry>
          <surface><friction><ode><mu>0.2</mu><mu2>0.2</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.4 0.605 0.02</size></box></geometry>
          <material><ambient>0.6 0.6 0.65 1</ambient><diffuse>0.6 0.6 0.65 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="zone_c">
      <static>true</static>
      <pose>3.0 0.9 0.005 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.8 0.01</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.8 0.01</size></box></geometry>
          <material><ambient>0.2 0.3 0.8 1</ambient><diffuse>0.2 0.3 0.8 1</diffuse></material>
        </visual>
        <collision name="cage_wall">
          <pose>0 0.6 0.4 0 0 0</pose>
          <geometry><box><size>1.2 0.05 0.8</size></box></geometry>
        </collision>
        <visual name="cage">
          <pose>0 0.6 0.4 0 0 0</pose>
          <geometry><box><size>1.2 0.05 0.8</size></box></geometry>
          <material><ambient>0.4 0.4 0.9 0.6</ambient><diffuse>0.4 0.4 0.9 0.6</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="zone_d">
      <static>true</static>
      <pose>3.5 -0.9 0.005 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2 0.8 0.01</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.2 0.8 0.01</size></box></geometry>
          <material><ambient>0.9 0.5 0.1 1</ambient><diffuse>0.9 0.5 0.1 1</diffuse></material>
        </visual>
        <collision name="cage_wall">
          <pose>0 -0.6 0.4 0 0 0</pose>
          <geometry><box><size>1.2 0.05 0.8</size></box></geometry>
        </collision>
        <visual name="cage">
          <pose>0 -0.6 0.4 0 0 0</pose>
          <geometry><box><size>1.2 0.05 0.8</size></box></geometry>
          <material><ambient>0.9 0.6 0.3 0.6</ambient><diffuse>0.9 0.6 0.3 0.6</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
